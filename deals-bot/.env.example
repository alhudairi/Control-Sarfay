# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=

# معرّف القناة: @اسم_القناة أو رقمها مثل -1001234567890
TELEGRAM_CHANNEL_ID=

# أرقام حسابات المشرفين المسموح لهم يستخدمون البوت (افصل بفاصلة)
# أرسل /start للبوت وبيعطيك رقمك
ADMIN_USER_IDS=

# كود التتبع من Amazon Associates (ينتهي غالباً بـ -21). مطلوب لروابط أمازون فقط
AMAZON_TAG=

# دومين أمازون
AMAZON_DOMAIN=www.amazon.sa

# سطر الإفصاح اللي ينضاف أسفل كل منشور (اتركه فاضي لإلغائه)
DISCLOSURE="#إعلان | قد أحصل على عمولة من المشتريات المؤهلة عبر روابط أمازون."
